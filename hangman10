using System;
using System.Collections.Generic;
using System.Linq;
using System.Threading;

namespace HangmanGame
{
    class Program
    {
        static void Main(string[] args)
        {
            Spiel spiel = new Spiel();
            spiel.StarteSpiel();
        }
    }

    public class Spiel
    {
        private KategorieManager kategorieManager = new KategorieManager();
        private Benutzeroberfläche ui = new Benutzeroberfläche();
        private TimerManager timerManager = new TimerManager();
        private int erlaubteFehler;
        private Wort aktuellesWort;

        public void StarteSpiel()
        {
            ui.Begrüßung();

            Kategorie kategorie = kategorieManager.KategorieWählen();
            aktuellesWort = kategorie.ZufälligesWort();
            string schwierigkeitsgrad = ui.SchwierigkeitWählen();
            SetzeFehlerLimitUndTimer(schwierigkeitsgrad);

            if (ui.MöchtestDuHinweisNumerisch())
                ui.ZeigeHinweis(aktuellesWort.Hinweis);

            List<char> errateneBuchstaben = new List<char>();
            List<char> verwendeteBuchstaben = new List<char>();
            int fehler = 0;

            while (fehler < erlaubteFehler && !aktuellesWort.IstVollständig(errateneBuchstaben) && !timerManager.Abgelaufen)
            {
                ui.ZeigeWort(aktuellesWort.Text, errateneBuchstaben);
                ui.ZeigeVerwendeteBuchstaben(verwendeteBuchstaben);
                ui.ZeigeVersuche(fehler, erlaubteFehler);
                char buchstabe = ui.BuchstabeEingeben();

                if (verwendeteBuchstaben.Contains(buchstabe))
                {
                    Console.WriteLine("⚠️ Du hast diesen Buchstaben bereits verwendet. Versuch es mit einem anderen.");
                    continue;
                }

                verwendeteBuchstaben.Add(buchstabe);

                if (aktuellesWort.Text.Contains(buchstabe))
                {
                    if (!errateneBuchstaben.Contains(buchstabe))
                        errateneBuchstaben.Add(buchstabe);
                }
                else
                {
                    fehler++;
                }

                timerManager.AktualisiereTimer();
            }

            timerManager.StoppeTimer();
            ui.ZeigeWort(aktuellesWort.Text, errateneBuchstaben);

            if (aktuellesWort.IstVollständig(errateneBuchstaben))
                ui.Gewonnen();
            else if (timerManager.Abgelaufen)
                ui.ZeitAbgelaufen();
            else
                ui.Verloren(aktuellesWort.Text);
        }

        private void SetzeFehlerLimitUndTimer(string schwierigkeitsgrad)
        {
            switch (schwierigkeitsgrad.ToLower())
            {
                case "leicht": erlaubteFehler = 8; timerManager.StarteTimer(aktuellesWort.Text.Length * 5); break;
                case "mittel": erlaubteFehler = 6; timerManager.StarteTimer(180); break;
                case "schwer": erlaubteFehler = 4; timerManager.StarteTimer(aktuellesWort.Text.Length * 3); break;
                default: erlaubteFehler = 6; timerManager.StarteTimer(180); break;
            }
        }
    }

    public class Wort
    {
        public string Text { get; private set; }
        public string Hinweis { get; private set; }

        public Wort(string text, string hinweis)
        {
            Text = text.ToLower();
            Hinweis = hinweis;
        }

        public bool IstVollständig(List<char> errateneBuchstaben)
        {
            return Text.All(c => errateneBuchstaben.Contains(c));
        }
    }

    public class Kategorie
    {
        public string Name { get; private set; }
        private List<Wort> Wörter;

        public Kategorie(string name)
        {
            Name = name;
            Wörter = new List<Wort>();
        }

        public void FügeWortHinzu(Wort wort)
        {
            Wörter.Add(wort);
        }

        public Wort ZufälligesWort()
        {
            Random rnd = new Random();
            return Wörter[rnd.Next(Wörter.Count)];
        }
    }

