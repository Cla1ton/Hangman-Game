    }

    public class TimerManager
    {
        private int verbleibendeZeit;
        private DateTime startZeit;
        private bool läuft;

        public bool Abgelaufen => verbleibendeZeit <= 0;

        public void StarteTimer(int sekunden)
        {
            verbleibendeZeit = sekunden;
            startZeit = DateTime.Now;
            läuft = true;
        }

        public void AktualisiereTimer()
        {
            if (läuft)
            {
                TimeSpan vergangen = DateTime.Now - startZeit;
                verbleibendeZeit = Math.Max(0, verbleibendeZeit - (int)vergangen.TotalSeconds);
                startZeit = DateTime.Now;
                Console.WriteLine($"\u23f3 Verbleibende Zeit: {verbleibendeZeit} Sekunden");
            }
        }

        public void StoppeTimer()
        {
            läuft = false;
        }
    }

    public class Benutzeroberfläche
    {
        public void Begrüßung()
        {
            Console.OutputEncoding = System.Text.Encoding.UTF8;
            Console.WriteLine("🎮 Willkommen bei Hangman (Deutsch)!");
            Console.WriteLine("----------------------------------\n");
            ZeigeStartBild();
        }

        public void ZeigeStartBild()
        {
            Console.WriteLine("   _____  ");
            Console.WriteLine("  /     \\ ");
            Console.WriteLine(" |  O  O |");
            Console.WriteLine(" |    ^  |");
            Console.WriteLine(" |   '-'  |");
            Console.WriteLine("  \\_____/ ");
            Console.WriteLine("Das Spiel beginnt!");
        }

        public string SchwierigkeitWählen()
        {
            Console.WriteLine("Wähle den Schwierigkeitsgrad:");
            Console.WriteLine("1. Leicht");
            Console.WriteLine("2. Mittel");
            Console.WriteLine("3. Schwer");
            int auswahl = ZahlEingeben(1, 3);
            return auswahl switch
            {
                1 => "leicht",
                2 => "mittel",
                3 => "schwer",
                _ => "mittel"
            };
        }

        public void ZeigeHinweis(string hinweis)
        {
            Console.WriteLine($"\n💡 Hinweis: {hinweis}");
        }

        public bool MöchtestDuHinweisNumerisch()
        {
            Console.WriteLine("Möchtest du einen Hinweis?");
            Console.WriteLine("1. Ja\n2. Nein");
            int wahl = ZahlEingeben(1, 2);
            return wahl == 1;
        }

        public void ZeigeWort(string wort, List<char> errateneBuchstaben)
        {
            Console.Write("Wort: ");
            foreach (char c in wort)
            {
                Console.Write(errateneBuchstaben.Contains(c) ? $"{c} " : "_ ");
            }
            Console.WriteLine("\n");
        }

        public void ZeigeVerwendeteBuchstaben(List<char> buchstaben)
        {
            Console.WriteLine("Benutzte Buchstaben: " + string.Join(", ", buchstaben));
        }

        public void ZeigeVersuche(int fehler, int limit)
        {
            string[] hangman = new string[]
            {
                "   _____  \n  |     | \n  |       \n  |       \n  |       \n  |       \n__|__\n",  // 0 Fehler
                "   _____  \n  |     | \n  |     O \n  |       \n  |       \n  |       \n__|__\n",  // 1 Fehler
                "   _____  \n  |     | \n  |     O \n  |     | \n  |       \n  |       \n__|__\n",  // 2 Fehler
                "   _____  \n  |     | \n  |     O \n  |    /| \n  |       \n  |       \n__|__\n",  // 3 Fehler
                "   _____  \n  |     | \n  |     O \n  |    /|\\ \n  |       \n  |       \n__|__\n",  // 4 Fehler
                "   _____  \n  |     | \n  |     O \n  |    /|\\ \n  |    /  \n  |       \n__|__\n",  // 5 Fehler
                "   _____  \n  |     | \n  |     O \n  |    /|\\ \n  |    / \\ \n  |       \n__|__\n",  // 6 Fehler
            };

            int index = Math.Min(fehler, hangman.Length - 1);
            Console.WriteLine(hangman[index]);
            Console.WriteLine($"❌ Fehler: {fehler} von {limit}\n");
        }

        public char BuchstabeEingeben()
        {
            Console.Write("🔤 Gib einen Buchstaben ein: ");
            string eingabe;
            while (true)
            {
                eingabe = Console.ReadLine().ToLower();
                if (!string.IsNullOrWhiteSpace(eingabe) && eingabe.Length == 1 && char.IsLetter(eingabe[0]))
                    return eingabe[0];
                Console.Write("Bitte gib **nur einen Buchstaben** ein: ");
            }
        }

        public void Gewonnen()
        {
            Console.WriteLine("🎉 Glückwunsch! Du hast das Wort erraten!");
        }

        public void Verloren(string korrektesWort)
        {
            Console.WriteLine($"😢 Leider verloren. Das richtige Wort war: {korrektesWort}");
        }

        public void ZeitAbgelaufen()
        {
            Console.WriteLine("⏰ Die Zeit ist abgelaufen! Du hast verloren.");
        }

        public static int ZahlEingeben(int min, int max)
        {
            int zahl;
            while (!int.TryParse(Console.ReadLine(), out zahl) || zahl < min || zahl > max)
            {
                Console.Write($"Bitte gib eine Zahl zwischen {min} und {max} ein: ");
            }
            return zahl;
        }
    }
}
